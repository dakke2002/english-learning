{
  "$schema": "https://zeabur.com/schema.json",
  "name": "english-learning-app",
  "build": {
    "cmd": "npm install && npm run build"
  },
  "run": {
    "cmd": "node server.js",
    "port": 8080,
    "health": {
      "path": "/",
      "initialDelaySeconds": 10
    }
  },
  "volumes": [
    {
      "mountPath": "/app/database.sqlite",
      "size": 1
    }
  ],
  "envs": [
    {
      "key": "NODE_ENV",
      "value": "production"
    },
    {
      "key": "JWT_SECRET",
      "value": "change-this-to-a-random-secret-key-in-production"
    }
  ]
}
